# Copy to .env for local development. In Hugging Face Spaces, set these as Space Secrets/Variables.

# --- Pinecone (Starter Tier) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=cloud-infra-docs
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_DIMENSION=768

# --- Ollama (Local Node or Cloudflare Tunnel HTTPS URL) ---
# Locally: http://localhost:11434
# On Hugging Face Spaces: https://ollama.your-domain.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Optional Cloudflare Access / custom proxy auth headers if protecting the tunnel
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# OLLAMA_BEARER_TOKEN=

# --- RAG Configuration ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RAG_TOP_K=4
LLM_TEMPERATURE=0.1

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=7860
LOG_LEVEL=INFO
